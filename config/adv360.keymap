#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <32 31 30 29 41 42 43 44>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 69 70 71 72 73 74 75 68 37 53>;
            hold-trigger-on-release;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1            &kp N2            &kp N3              &kp N4                &kp N5  &tog 2                                                     &mo 1       &kp N6  &kp N7                 &kp N8               &kp N9             &kp N0             &kp MINUS
&kp PIPE   &kp Q             &kp W             &kp F               &kp P                 &kp G   &mo 1                                                      &mo 3       &kp J   &kp L                  &kp U                &kp Y              &kp SEMI           &kp BSLH
&kp MINUS  &hm_l LEFT_WIN A  &hm_l LEFT_ALT R  &hm_l LEFT_SHIFT S  &hm_l LEFT_CONTROL T  &kp D   &mo 2      &kp LG(C)  &kp LG(V)      &kp LGUI   &kp RCTRL  &mo 4       &kp H   &hm_r RIGHT_CONTROL N  &hm_r RIGHT_SHIFT E  &hm_r RIGHT_ALT I  &hm_r RIGHT_WIN O  &kp SQT
&kp TILDE  &kp Z             &kp X             &kp C               &kp V                 &kp B                         &kp TAB        &kp PG_UP                         &kp K   &kp M                  &kp COMMA            &kp DOT            &kp FSLH           &kp RA(NUMBER_3)
&kp STAR   &kp LEFT_BRACE    &kp RIGHT_BRACE   &kp LEFT_BRACKET    &kp RIGHT_BRACKET             &kp SPACE  &kp ENTER  &kp ESC        &kp CAPS   &kp BSPC   &kp DELETE          &kp LEFT               &kp DOWN             &kp UP             &kp RIGHT          &kp PERCENT
            >;
        };

        kp {
            display-name = "Mod";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                                   &trans           &trans  &kp N7        &kp N8        &kp N9  &trans     &trans
&trans          &trans        &trans        &trans        &trans        &trans        &bootloader                                              &bootloader      &trans  &kp N4        &kp N5        &kp N6  &trans     &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT     &trans  &kp NUMBER_1  &kp NUMBER_2  &kp N3  &trans     &trans
&trans          &trans        &trans        &trans        &macro_ver    &trans                             &trans      &trans                                   &trans  &trans        &kp N0        &trans  &kp ENTER  &kp RSHFT
&trans          &trans        &trans        &trans        &trans                      &trans       &trans  &trans      &trans      &bl BL_TOG  &rgb_ug RGB_TOG          &bl BL_INC    &bl BL_DEC    &trans  &trans     &trans
            >;

            label = "kp";
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 0                                      &mo 1   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                                                   &trans           &trans  &kp N7        &kp N8        &kp N9  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &bootloader                                              &bootloader      &trans  &kp N3        &kp N4        &kp N5  &trans  &trans
&studio_unlock  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans      &bt BT_CLR  &trans      &stp STP_BAT     &trans  &kp NUMBER_1  &kp NUMBER_2  &kp N3  &trans  &trans
&trans          &trans        &trans        &trans        &macro_ver    &trans                             &trans      &trans                                   &trans  &trans        &kp N0        &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                      &trans       &trans  &trans      &trans      &bl BL_TOG  &rgb_ug RGB_TOG          &bl BL_INC    &bl BL_DEC    &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans          &trans             &trans           &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp K_MUTE      &kp C_VOLUME_UP    &kp PRINTSCREEN  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp K_PREVIOUS  &kp K_PLAY_PAUSE   &kp K_NEXT       &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &kp C_VOLUME_DOWN  &trans           &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans             &trans                   &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
